# Copier ce fichier en « .env » (meme dossier) et remplir les valeurs. Ne JAMAIS commiter .env.
# Attention : les valeurs contenant « $ » (le hash BCrypt) doivent rester entre apostrophes simples.

# Nom de domaine (ou sous-domaine) pointant deja vers l'adresse IP du serveur. Sans « https:// ».
DOMAIN=afrivox.example.org

# Adresse utilisee par Let's Encrypt pour les avis d'expiration
LETSENCRYPT_EMAIL=admin@example.org

# Mot de passe de la base (long et aleatoire) : openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# Secret de signature des jetons JWT, en Base64, 64 octets au moins : openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=

# Hash BCrypt du mot de passe du compte « admin » cree au premier demarrage (voir README.md pour le calculer)
ADMIN_PASSWORD_HASH='$2a$10$remplacer-par-le-hash-bcrypt'
