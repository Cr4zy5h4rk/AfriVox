    <!--
        Added the constraints for entity CreditTransaction.
    -->
    <changeSet id="20261006131541-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="profile_id"
                                 baseTableName="credit_transaction"
                                 constraintName="fk_credit_transaction__profile_id"
