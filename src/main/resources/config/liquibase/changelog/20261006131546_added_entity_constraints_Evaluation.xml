    <!--
        Added the constraints for entity Evaluation.
    -->
    <changeSet id="20261006131546-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="model_id"
                                 baseTableName="evaluation"
                                 constraintName="fk_evaluation__model_id"
