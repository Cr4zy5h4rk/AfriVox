<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity MlModel.
    -->
    <changeSet id="20261006131549-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="owner_id"
                                 baseTableName="ml_model"
                                 constraintName="fk_ml_model__owner_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="language_id"
                                 baseTableName="ml_model"
                                 constraintName="fk_ml_model__language_id"
                                 referencedColumnNames="id"
                                 referencedTableName="language"
                                 />

        <addForeignKeyConstraint baseColumnNames="trained_on_id"
                                 baseTableName="ml_model"
                                 constraintName="fk_ml_model__trained_on_id"
                                 referencedColumnNames="id"
                                 referencedTableName="dataset_version"
                                 />
    </changeSet>
</databaseChangeLog>
