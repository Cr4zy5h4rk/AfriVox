    <!--
        Added the constraints for entity Recording.
    -->
    <changeSet id="20261006131551-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="prompt_id"
                                 baseTableName="recording"
                                 constraintName="fk_recording__prompt_id"
