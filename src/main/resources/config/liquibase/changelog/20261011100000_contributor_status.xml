<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Periode d'essai des contributeurs. Les profils deja existants passent en ACTIVE (valeur par defaut de la
        colonne) : la periode d'essai ne concerne que les profils crees ensuite pour un compte CONTRIBUTOR.
    -->
    <changeSet id="20261011100000-1" author="afrivox">
        <addColumn tableName="user_profile">
            <column name="contributor_status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
