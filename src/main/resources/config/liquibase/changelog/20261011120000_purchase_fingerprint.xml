<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Empreinte secrete d'un achat : elle sert a personnaliser la copie telechargee (noms de fichiers, ordre,
        marquage des audios WAV) pour pouvoir retrouver l'acheteur si un jeu de donnees est diffuse sans autorisation.
        Les achats deja faits recoivent la leur au premier telechargement.
    -->
    <changeSet id="20261011120000-1" author="afrivox">
        <addColumn tableName="purchase">
            <column name="fingerprint" type="varchar(40)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
